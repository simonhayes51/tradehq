# Copy to .env, fill in real values, and set these as environment
# variables in Coolify (project-level, so all services can see them).
# docker-compose.yml references these by name - it does not read this
# file directly.

# --- Database (one Postgres, shared by every service) ---------------------
POSTGRES_PASSWORD=

# --- Backend: required to boot (main.py:90 checks these explicitly) -------
SECRET_KEY=
JWT_PRIVATE_KEY=
ENV=production
FRONTEND_URL=https://app.eafc.live
COOKIE_DOMAIN=.eafc.live
SESSION_COOKIE_DOMAIN=.eafc.live
SESSION_COOKIE_SAMESITE=lax
# Comma-separated proxy IPs/hosts that may supply X-Forwarded-* headers.
# For Coolify, set this to the real proxy hop rather than "*".
TRUSTED_PROXY_HOSTS=127.0.0.1,::1
# Email/password auth is unfinished; Discord auth is the launch path.
ENABLE_EMAIL_AUTH=0
# Set to 0 only for a web-only replica. At least one production instance
# must run workers for prices, recommendations, Discord sync, etc.
RUN_BACKGROUND_WORKERS=1

# --- Backend: Discord login - required if Discord auth is used ------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Application ("client") ID of the Discord app. Optional - the backend
# resolves it from DISCORD_BOT_TOKEN at boot if unset.
DISCORD_APPLICATION_ID=
# Public key from the Developer Portal - required to verify interactions.
DISCORD_PUBLIC_KEY=
# Slash-command registration at boot (app/services/discord_command_sync.py).
# Defaults shown; set DISCORD_SYNC_COMMANDS_ON_BOOT=0 to disable, or
# DISCORD_COMMAND_SYNC_STRICT=1 to fail the boot when registration fails.
DISCORD_SYNC_COMMANDS_ON_BOOT=1
DISCORD_COMMAND_SYNC_STRICT=0
DISCORD_EXPECTED_APPLICATION_ID=1408193521986437251
DISCORD_COMMAND_SYNC_GUILD_IDS=818516082934546432
DISCORD_MEMBER_ROLE_ID=
DISCORD_INVITE_URL=
DISCORD_OPPORTUNITY_CHANNEL_ID=
DISCORD_PROOF_CHANNEL_ID=
# Optional tuning (opportunity alerts default to at most every 3 hours)
DISCORD_RECONCILE_INTERVAL_SECONDS=60
DISCORD_OPPORTUNITY_BATCH_MIN=5
DISCORD_OPPORTUNITY_COOLDOWN_MINUTES=180
DISCORD_OPPORTUNITY_DEDUP_HOURS=24
DISCORD_PROOF_REPORT_TIMEZONE=Europe/London
DISCORD_PROOF_REPORT_HOUR=21
DISCORD_PROOF_REPORT_MINUTE=0

# --- Backend: Stripe billing - required if subscriptions are used ---------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_SEASON_PRICE_ID=
STRIPE_TRIAL_DAYS=7

# --- Backend: investment engine launch posture ----------------------------
# Calculate in shadow first. Do not publish customer-visible investment
# calls until live BIN/sales/supply confirmation is proven.
INVESTMENT_ENGINE_ENABLED=true
INVESTMENT_ENGINE_PUBLISH_SIGNALS=false
INVESTMENT_ENGINE_FC26_PRIOR_ENABLED=true
INVESTMENT_ENGINE_INTERVAL_SECONDS=300
INVESTMENT_ENGINE_COHORT_REFRESH_INTERVAL_SECONDS=21600
INVESTMENT_MIN_COHORT_SIZE=20
INVESTMENT_MIN_FRESH_PRICE_FRACTION=0.60
INVESTMENT_MIN_MARKET_STATE_OBS=6
INVESTMENT_MIN_CARDS_WITH_SALES=10

# --- Backend: launch safety / Discord trading feed ------------------------
# Leave off until collector freshness and opportunity quality are proven.
DISCORD_TRADING_FEED_ENABLED=0
DISCORD_TRADING_FEED_POLL_SECONDS=300
# Temporary kill switch for volatile launch-market conditions.
EAFC_MARKET_SHOCK_PAUSE_UNTIL=off

# --- Backend: AI controls --------------------------------------------------
OPENAI_API_KEY=
AI_CHAT_ENABLED=0
AI_DAILY_COST_LIMIT_GBP=10
AI_USER_DAILY_LIMIT=25

# --- Backend: optional -----------------------------------------------------
# REDIS_URL - app/auth/api_keys.py and app/routers/v2/ai_chat.py import
# redis lazily inside functions, not at module load, so the backend boots
# fine without it. Not wired into docker-compose.yml; add a redis service
# yourself if whatever feature needs it turns out to matter to you.
# REDIS_URL=

# --- Frontend: baked into the build, not read at runtime -------------------
# This is your PUBLIC backend URL, i.e. wherever Coolify exposes the
# `backend` service (a domain you assign in Coolify, not the internal
# "backend" hostname docker-compose uses - the browser calls this
# directly, not through the compose network). Changing this requires a
# frontend rebuild, not just a restart - see frontend/Dockerfile.
PUBLIC_API_URL=https://api.yourdomain.example
VITE_DISCORD_INVITE_URL=

# --- auto_sync: no extra required vars beyond DATABASE_URL -----------------
# FUTGG_BULK_APPLY defaults to true in docker-compose.yml (auto_sync's own
# default is also true - this just makes it explicit). Set to "false" on
# the futgg_bulk_price_worker service if you want a read-only trial run
# before it starts writing prices.
