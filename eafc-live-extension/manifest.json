{
  "manifest_version": 3,
  "name": "EAFC Live Companion",
  "version": "0.1.1",
  "description": "Read-only EAFC Live intelligence overlay for the EA SPORTS FC Web App transfer market. Never bids, buys, lists, or automates trading.",
  "host_permissions": [
    "https://api.futhub.co.uk/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/*ultimate-team*web-app*"
      ],
      "js": ["src/debug-flag.js", "src/card-detector.js", "src/ea-session.js", "src/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.ea.com/*ultimate-team*web-app*"
      ],
      "js": [
        "src/debug-flag.js",
        "src/config.js",
        "src/card-detector.js",
        "src/market-calc.js",
        "src/eafc-api.js",
        "src/market-observer.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
