{
  "manifest_version": 3,
  "name": "EAFC Live Companion",
  "version": "0.1.0",
  "description": "Read-only EAFC Live intelligence overlay for the EA SPORTS FC Web App transfer market. Never bids, buys, lists, or automates trading.",
  "host_permissions": [
    "https://www.ea.com/*",
    "https://*.ea.com/*",
    "https://*.easports.com/*",
    "https://*.tradehq.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/*ultimate-team*web-app*",
        "https://www.ea.com/fifa/ultimate-team/web-app/*",
        "https://*.ea.com/*ultimate-team*web-app*"
      ],
      "js": ["src/ea-session.js", "src/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.ea.com/*ultimate-team*web-app*",
        "https://www.ea.com/fifa/ultimate-team/web-app/*",
        "https://*.ea.com/*ultimate-team*web-app*"
      ],
      "js": [
        "src/config.js",
        "src/card-detector.js",
        "src/market-calc.js",
        "src/eafc-api.js",
        "src/market-observer.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
