# SalesSync - completed-sales history sync via FUT.GG's signed JSON
# price-access endpoint, with the bulk price worker bundled for Railway.
#
# futgg_sales_sync.py is already long-running: its __main__ calls
# run_forever(), which loads one fut.gg page ONCE (the anchor page) and
# reuses it for the process lifetime, doing sign+fetch batches against it
# in an internal loop (select due cards -> batch sign+fetch -> sleep
# CYCLE_SLEEP/IDLE_SLEEP -> repeat). It is NOT one-shot, so this image
# runs it directly with no extra loop wrapper - wrapping an
# already-looping process in another sleep loop would just double-sleep
# for no benefit, and would throw away the warm browser/page the script
# deliberately keeps alive between cycles.
#
# Railway currently deploys this Dockerfile as the live worker. To make
# that single service use the intended two-stage data path, the entrypoint
# also starts futgg_bulk_price_sync.py in the background by default. Bulk
# prices come from FUT.GG's captured catalogue feed; signed per-card calls
# are then capped and paced for completed sales history instead of trying
# to refresh price freshness for the whole catalogue.
#
# Set FUTGG_RUN_BULK_WITH_SALES=false only if PriceSync is deployed as a
# separate service from Dockerfile.price.
#
# Deploy this as a normal continuous Coolify/Railway service (NOT a
# Scheduled Task) - see auto_sync/COOLIFY.md.
#
# Still needs the Playwright base image: sales are fetched via one of two
# transports (FUTGG_SALES_TRANSPORT=signed_fetch|page_capture|auto) - both
# run entirely inside a live fut.gg browser context, same-origin, so no
# CORS, with the browser supplying cookies/TLS/sec-fetch-* headers exactly
# as the real app does. No new dependencies are required for page_capture;
# it reuses the same Playwright browser/context signed_fetch already
# needs. See futgg_sales_sync.py's own module docstring for the full
# mechanism and COOLIFY.md for the env vars.
#
# HEADED CHROMIUM VIA XVFB (2026-08-04 headless-detection finding):
# production diagnostics confirmed Cloudflare challenges
# /api/fut/player-prices/26/<id>/?verify=... based on the browser being
# HEADLESS (leaked via navigator.userAgentData's own "HeadlessChrome" -
# visible in this worker's own outbound analytics traffic - regardless of
# the spoofed User-Agent header), not on which transport requests it -
# both signed_fetch and a fully organic page_capture navigation were
# challenged identically while headless. Running headed instead removes
# that signal, matching the same headed-vs-headless difference already
# confirmed for FUTBIN's Cloudflare (see Dockerfile.sbc's git history);
# see docker-entrypoint-sales.sh's own comment for the full reasoning and
# caveat. PLAYWRIGHT_HEADLESS=false is the default here; override back to
# true only if a real X display is not wanted for some reason (then this
# worker is back to being challenged, per the diagnostic evidence).
#
# No port: this worker only talks to fut.gg and DATABASE_URL, never
# serves HTTP.

FROM mcr.microsoft.com/playwright/python:v1.61.0-noble

ENV PYTHONUNBUFFERED=1
ENV DISPLAY=:99

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Belt-and-suspenders: the official Playwright Python image already ships
# Chromium plus its Linux system deps (including, in every version
# checked at the time this was written, Xvfb) - not reinstalled here per
# the instruction not to duplicate what the base image already provides.
# Intentionally not a hard build failure if missing, so a base-image
# change surfaces as a clear runtime log line instead of a silent,
# confusing worker crash.
RUN command -v Xvfb > /dev/null 2>&1 \
    && echo "Xvfb present in base image" \
    || echo "WARNING: Xvfb not found in base image - worker will fail at runtime"

COPY . .

# chmod runs AFTER the full COPY, not before - relying on git to preserve
# the executable bit through clone/checkout is fragile; this guarantees
# it regardless.
RUN chmod +x /app/docker-entrypoint-sales.sh

ENV PLAYWRIGHT_HEADLESS=false
ENV FUTGG_RUN_BULK_WITH_SALES=true
# Reverted to 60/300 (2026-09-07) - back to Friday 2026-09-04's values.
# 22b1b60 raised these to 120/90 that same evening to close a
# ~709-720 vs ~1,327 cards/hour shortfall against demand (see that
# commit's own message for the math) - a real fix for sales data
# falling behind, but it also raised SalesSync's sustained write rate
# into futgg_sales_history by ~1.85x. Every day after that deploy added
# proportionally more rows to whatever window futgg_market_snapshot's
# refresh scans, and production evidence (2026-09-07) traced Postgres
# CPU pegging at 86-172% - on a Coolify server shared with the backend
# app itself - directly to that refresh plus other periodic jobs
# converging under the higher load. The host's CPU allocation was
# adequate for the pre-2026-09-04 ingestion rate and is not adequate
# for the post-2026-09-04 one; reverting the rate is the same-day fix
# until the server itself is resized (or Postgres is moved off the
# shared host) to actually support the higher target.
ENV FUTGG_SALES_SELECT_LIMIT_MAX=60
ENV FUTGG_SALES_CYCLE_SLEEP_MIN=300
ENV FUTGG_SALES_CYCLE_SLEEP_FORCE=true

CMD ["/app/docker-entrypoint-sales.sh"]