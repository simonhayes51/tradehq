# ContentSync - FUT.GG SBC, exact cheapest squads, and FC27 Gallery.
#
# CANONICAL SCRIPT: futgg_content_sync.py. It replaces EasySBC entirely and
# writes into the existing market-event tables plus the Gallery/solution
# tables introduced by backend migration 100.
#
# The Python collector remains one-shot and advisory-locked. The entrypoint
# supervises it at a six-hour cadence because the deployed Coolify resource is
# a normal service; this prevents failure/restart storms. A Scheduled Task can
# set FUTGG_CONTENT_RUN_ONCE=true.
#
# FUT.GG returns Cloudflare 403s to plain server HTTP. The collector therefore
# uses headed Chromium through Xvfb, matching the proven sales-worker path.
#
# ONLY REQUIRED DEPENDENCIES: requirements-sbc.txt.
#
# The supervisor retries failures after 15 minutes and successful runs after
# six hours; both intervals are configurable in the entrypoint.
#
# No port: this worker only talks to FUT.GG and DATABASE_URL.

FROM mcr.microsoft.com/playwright/python:v1.61.0-noble

WORKDIR /app

COPY requirements-sbc.txt .
RUN pip install --no-cache-dir -r requirements-sbc.txt

COPY . .

RUN chmod +x /app/docker-entrypoint-sbc.sh

ENV PYTHONUNBUFFERED=1
ENV DISPLAY=:99
ENV PLAYWRIGHT_HEADLESS=false

CMD ["bash", "/app/docker-entrypoint-sbc.sh"]
