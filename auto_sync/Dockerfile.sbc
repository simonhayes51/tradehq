# ContentSync - FUT.GG SBC, exact cheapest squads, and FC27 Gallery.
#
# CANONICAL SCRIPT: futgg_content_sync.py. It replaces EasySBC entirely and
# writes into the existing market-event tables plus the Gallery/solution
# tables introduced by backend migration 100.
#
# ONE-SHOT: crawl_once() runs once and exits (same shape as
# futgg_player_sync.py's crawl_once()). No loop wrapper here, matching
# the script's own documented Cron Job design and avoiding the exact
# restart-loop failure mode this repo's PlayerSync worker hit - deploy
# this as a Coolify Scheduled Task, not a continuous service. See
# auto_sync/COOLIFY.md.
#
# FUT.GG's listing and content APIs are public HTTP resources, so this remains
# a small aiohttp-only scheduled image with no browser/Xvfb dependency.
#
# ONLY REQUIRED DEPENDENCIES: requirements-sbc.txt (aiohttp + asyncpg).
#
# EXIT CODE: futgg_content_sync.py exits 0 on a genuinely
# successful (or benignly lock-skipped) run and non-zero on a real
# failure (crawl_once() returning False, or an uncaught exception) - so
# Coolify's Scheduled Task run history reflects real success/failure, not
# just "the container didn't crash".
#
# No port: this worker only talks to FUT.GG and DATABASE_URL.

FROM python:3.11-slim

WORKDIR /app

COPY requirements-sbc.txt .
RUN pip install --no-cache-dir -r requirements-sbc.txt

COPY . .

ENV PYTHONUNBUFFERED=1

CMD ["python", "futgg_content_sync.py"]
