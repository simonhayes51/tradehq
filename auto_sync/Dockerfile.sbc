# SBCSync - SBC set/challenge collector.
#
# CANONICAL SCRIPT: easysbc_sbc_sync.py, not futbin_sbc_sync.py.
#
# futbin_sbc_sync.py (Playwright + Xvfb, headed Chromium) is confirmed
# NOT reliably usable: FUTBIN's Cloudflare hard-blocks it from every
# network origin tested, including a real Railway deployment with Xvfb
# working correctly right up to the actual page request (immediate HTTP
# 403 "Just a moment...", a WAF block on IP/network origin - not a
# solvable JS challenge). See futbin_sbc_sync.py's and easysbc_sbc_sync.
# py's own module docstrings, and README.md's "SBC collector" sections,
# for the full history.
#
# easysbc_sbc_sync.py replaces it: EasySBC.io's frontend is backed by a
# plain, unauthenticated JSON API, so this is aiohttp-only - no browser,
# no Xvfb, no Cloudflare challenge to fight. Its own docstring states the
# design explicitly: "Same one-shot-per-invocation Cron Job design ... not
# a permanent worker, no Procfile entry."
#
# ONE-SHOT: crawl_once() runs once and exits (same shape as
# futgg_player_sync.py's crawl_once()). No loop wrapper here, matching
# the script's own documented Cron Job design and avoiding the exact
# restart-loop failure mode this repo's PlayerSync worker hit - deploy
# this as a Coolify Scheduled Task, not a continuous service. See
# auto_sync/COOLIFY.md.
#
# No Playwright needed for this script, so this uses the plain slim
# Python base (matching backend/Dockerfile's own python:3.11-slim
# convention) rather than the ~1.5GB Playwright browser image the other
# two workers require - smaller image, faster Scheduled Task cold start.
# docker-entrypoint-sbc.sh (Xvfb bootstrap for the old futbin_sbc_sync.py
# path) is left in the repo, unused by this Dockerfile, in case FUTBIN's
# block ever lifts and that path needs revisiting - see README.md.
#
# No port: this worker only talks to api-fc26.easysbc.io and
# DATABASE_URL, never serves HTTP.

FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1

CMD ["python", "easysbc_sbc_sync.py"]
