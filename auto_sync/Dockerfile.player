# PlayerSync - FUT.GG player-catalogue metadata sync.
#
# futgg_player_sync.py is genuinely one-shot: it does one crawl_once()
# pass (discover new listing pages, upsert futgg_players rows) and exits -
# see its own module docstring ("Recommended Railway Cron: once daily").
# It needs a real Chromium (Playwright) to render fut.gg's listing pages,
# so this stays on the Playwright base image; nothing lighter works here.
#
# This is the fix for the reported bug: deploying this with Coolify's
# default "restart on exit" behaviour turns a clean one-shot exit into a
# restart-loop that re-scrapes the first FUTGG_LISTING_MAX_PAGES listing
# pages every few seconds. There is deliberately no sleep/while-loop
# wrapper in this image - the correct fix is deploying it as a Coolify
# Scheduled Task (cron-driven, one container run per trigger, no restart
# policy fighting a clean exit), documented in auto_sync/COOLIFY.md.
#
# No port: this worker only talks to fut.gg and DATABASE_URL, never
# serves HTTP.

FROM mcr.microsoft.com/playwright/python:v1.61.0-noble

ENV PYTHONUNBUFFERED=1
ENV DISPLAY=:99

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN command -v Xvfb > /dev/null 2>&1 \
    && echo "Xvfb present in base image" \
    || echo "WARNING: Xvfb not found in base image - worker will fail at runtime"

COPY . .

RUN chmod +x /app/docker-entrypoint-player.sh

ENV PLAYWRIGHT_HEADLESS=false
ENV FUTGG_GAME_YEAR=27

CMD ["/app/docker-entrypoint-player.sh"]
