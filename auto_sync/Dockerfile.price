# PriceSync - bulk FUT.GG price/BIN ingest.
#
# The bulk feed is only obtainable by loading a real FUT.GG page and
# observing the page's own requests. Production diagnostics on 2026-09-08
# showed FUT.GG returning Cloudflare's "Attention Required" page to this
# worker while it ran as HeadlessChrome. SalesSync already avoids the same
# headless signal by running headed Chromium against Xvfb, so PriceSync now
# uses that same browser shape.
#
# Deploy as a normal continuous Coolify service, not a Scheduled Task.

FROM mcr.microsoft.com/playwright/python:v1.61.0-noble

ENV PYTHONUNBUFFERED=1
ENV DISPLAY=:99

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN command -v Xvfb > /dev/null 2>&1 \
    && echo "Xvfb present in base image" \
    || echo "WARNING: Xvfb not found in base image - PriceSync will fail at runtime"

COPY . .
RUN chmod +x /app/docker-entrypoint-price.sh

ENV PLAYWRIGHT_HEADLESS=false
ENV FUTGG_BULK_APPLY=true

CMD ["/app/docker-entrypoint-price.sh"]
