# PriceSync - bulk FUT.GG price/BIN ingest (the whole ~27k-card catalogue
# from one page load - see futgg_bulk_price_sync.py's own module
# docstring for why this replaced per-card scraping).
#
# futgg_bulk_price_sync.py is already long-running: its __main__ calls
# run_forever(), which holds one Playwright browser/page open for the
# process lifetime and loops internally (ingest cycle -> sleep
# FUTGG_BULK_INTERVAL_SECONDS -> repeat). It is NOT one-shot, so this
# image runs it directly with no extra loop wrapper - wrapping an
# already-looping process in another sleep loop would just double-sleep
# between cycles for no benefit, and would throw away the warm
# browser/page the script deliberately keeps alive between batches.
#
# Deploy this as a normal continuous Coolify service (NOT a Scheduled
# Task) - see auto_sync/COOLIFY.md.
#
# Still needs the Playwright base image: the bulk feed itself
# (r2.fut.gg's static price JSON) is only reachable by letting a real
# fut.gg page load and listening for the requests it makes - see the
# TRANSPORT section of futgg_bulk_price_sync.py's docstring for why a
# plain HTTP client can't do this (r2.fut.gg 403s direct/CORS requests).
#
# FUTGG_BULK_APPLY defaults to true in the script itself
# (futgg_bulk_price_sync.py's `APPLY = env_bool("FUTGG_BULK_APPLY", True)`)
# - set explicitly here anyway so the Coolify service's own config is the
# visible source of truth rather than relying on a script-level default a
# future edit could silently change. Override to "false" only for a
# read-only coverage-check run.
#
# No port: this worker only talks to fut.gg and DATABASE_URL, never
# serves HTTP.

FROM mcr.microsoft.com/playwright/python:v1.61.0-noble

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_HEADLESS=true
ENV FUTGG_BULK_APPLY=true

CMD ["python", "futgg_bulk_price_sync.py"]
